{
  "name": "@overengineered-solutions/eslint-plugin-portfolio",
  "version": "0.4.0",
  "description": "Portfolio-wide ESLint rules: OES observability doctrine (no-untyped-external-response) + Tailwind v4 bracketed-route CSS-drop guard (no-tailwind-arbitrary-in-bracketed-route) + workspace-scoped credential resolution (no-platform-stripe-in-tenant-scope).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overengineered-solutions/eslint-plugin-portfolio.git"
  },
  "homepage": "https://github.com/overengineered-solutions/eslint-plugin-portfolio#readme",
  "bugs": {
    "url": "https://github.com/overengineered-solutions/eslint-plugin-portfolio/issues"
  }
}
